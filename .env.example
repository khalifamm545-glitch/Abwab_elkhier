# =============================================================================
# أبواب الخير (Abwab El Khair) — Environment Variables Template
# Architecture: Cloudflare Workers + Neon PostgreSQL + Cloudflare R2
# NEVER commit real secrets to Git — store secrets locally in gitignored `.env`
# and in production via `npx wrangler secret put <KEY>`.
# =============================================================================

# --- Server & Public URL (Node.js Local / Self-Hosted Mode) ---
PORT="3000"
NODE_ENV="production"
APP_URL="https://abwab-el-khair.workers.dev"

# --- Primary Structured Database: Neon PostgreSQL (Free Tier — Zero Cloud SQL) ---
# Example: postgresql://user:password@ep-xxxx.eu-west-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# --- Security Secret (Required in Production) ---
# Cryptographically random 64-byte hex secret used for:
#   1) HMAC-SHA256 Session JWT signing
#   2) AES-256-GCM encryption of Beneficiary National IDs at rest
#   3) AES-256-GCM encryption of periodic R2 backup archives
SESSION_SECRET="REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_64_BYTE_HEX"

# --- Encrypted Backup Retention Policy (Cloudflare R2 & Local Encrypted Vault) ---
BACKUP_RETENTION_COUNT="30"
BACKUP_RETENTION_DAYS="90"

# --- Local Fallback Storage Directory (Node.js Development Only) ---
# Not used on Cloudflare Workers (Workers use Neon PostgreSQL + R2 binding ABWAB_FILES)
DATA_DIR="./data"
